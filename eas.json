{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "true",
        "EXPO_PUBLIC_MOBILE_API_URL": "https://facepay-core.vercel.app",
        "FACEPAY_STORE": "preview"
      }
    },
    "native-test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_MOBILE_API_URL": "https://facepay-core.vercel.app",
        "FACEPAY_STORE": "internal-test"
      }
    },
    "apple": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_MOBILE_API_URL": "https://facepay-core.vercel.app",
        "FACEPAY_STORE": "apple"
      }
    },
    "google": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_MOBILE_API_URL": "https://facepay-core.vercel.app",
        "FACEPAY_STORE": "google"
      }
    },
    "huawei": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_MOBILE_API_URL": "https://facepay-core.vercel.app",
        "FACEPAY_STORE": "huawei"
      }
    }
  },
  "submit": {
    "apple": {},
    "google": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
