{
  "name": "facepay-app-live",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:android": "eas build --platform android --profile google",
    "build:ios": "eas build --platform ios --profile apple",
    "build:huawei": "eas build --platform android --profile huawei",
    "build:preview": "eas build --platform android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.31",
    "expo-asset": "^57.0.19",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "expo-task-manager": "~57.0.21",
    "libphonenumber-js": "^1.13.15",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
